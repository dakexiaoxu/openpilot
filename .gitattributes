openpilot/system/hardware/tici/updater -filter -diff -merge -text
*.svg -filter -diff -merge -text
*.png -filter -diff -merge -text
*.gif -filter -diff -merge -text
*.ttf -filter -diff -merge -text
*.otf -filter -diff -merge -text
*.wav -filter -diff -merge -text
docs/assets/comma-logo.png -filter -diff -merge -text
openpilot/tools/cabana/assets/cabana-icon.png -filter -diff -merge -text
openpilot/selfdrive/carrot/web/assets/alert_camera.svg -filter -diff -merge -text
openpilot/selfdrive/carrot/web/assets/alert_police.svg -filter -diff -merge -text
